# Replace the host with the IPv4 address of the machine running the backend.
# Example on Windows: run `ipconfig`, then use the Wi-Fi IPv4 address.
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IPV4:8081/api/v1

# Cloudinary unsigned upload config. Do not put API secret values in Expo env.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=dymxljxse
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=unsigned_upload
EXPO_PUBLIC_CLOUDINARY_UPLOAD_FOLDER=helphub
